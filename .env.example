# =============================================================================
# Environment Variables Template — Vidya Vani (#VoiceForBharat Day 2)
# Copy this file to .env.local in both backend/ and frontend/ and fill in real values.
# DO NOT commit real API keys to GitHub!
# =============================================================================

# LiveKit Real-time Voice Transport (https://cloud.livekit.io)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# Murf Falcon TTS (https://murf.ai/api/dashboard)
MURF_API_KEY=your_murf_api_key_here

# Deepgram STT (https://console.deepgram.com)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Google Gemini LLM (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your_google_api_key_here

# Optional agent name
AGENT_NAME=my-agent
