# =============================================================================
# Git Ignore Configuration — Vidya Vani (#VoiceForBharat Day 1)
# =============================================================================

# Secret Environment Files (NEVER commit API Keys to GitHub)
.env
.env.local
.env.*.local
*.env
backend/.env.local
frontend/.env.local

# Allow example environment templates
!.env.example
!backend/.env.example
!frontend/.env.example

# Markdown Drafts & Submission Notes (Ignore extra markdown files except main README.md)
*.md
!README.md

# Dependencies & Virtual Environments
node_modules/
frontend/node_modules/
.venv/
backend/.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/

# Build & Framework Outputs
.next/
frontend/.next/
out/
build/
dist/

# Logs & Temporary OS / IDE files
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
.DS_Store
.vscode/
.idea/
